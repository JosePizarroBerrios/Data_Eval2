
# =====================================================
# VARIABLES DE ENTORNO - BASE DE DATOS (Desarrollo)
# =====================================================

# Credenciales de MySQL
DB_ROOT_PASSWORD=contraseña123
DB_USER=appuser
DB_USER_PASSWORD=appuser_password_dev
DB_NAME=proyecto_db
DB_HOST=localhost
DB_PORT=3306

# =====================================================
# VARIABLES DE DOCKER
# =====================================================

# Información del contenedor
DB_CONTAINER_NAME=data_service
DOCKER_USER=jpizarroberrios


# =====================================================
# VARIABLES DE PERSISTENCIA
# =====================================================

# Volúmenes
DB_VOLUME_NAME=db_persistence
DB_VOLUME_PATH=/var/lib/mysql

=====================================


# =====================================================
# CONFIGURACIÓN DE ENTORNO
# =====================================================

# Ambiente (development, staging, production)
ENVIRONMENT=development

# =====================================================
# VARIABLES DE SEGURIDAD
# =====================================================

# Reinicio automático del contenedor
CONTAINER_RESTART_POLICY=always

